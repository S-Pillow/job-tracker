generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "sqlite"
}

/// Task types supported by Job Tracker
enum TaskType {
  TERMINATION
  NAME_CHANGE
  ASSIGNMENT
}

/// Step status values
enum StepStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  COMPLETE
  NA
}

/// Step templates are versioned per template
model Template {
  id        String         @id @default(cuid())
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  name      String
  taskType  TaskType
  version   Int
  isDefault Boolean        @default(false)

  steps     TemplateStep[]

  // Tasks created from this template
  tasks     Task[]

  @@unique([taskType, version])
}

model TemplateStep {
  id          String    @id @default(cuid())
  template    Template  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId  String

  order         Int
  title         String
  description   String?
  isConditional Boolean @default(false)
  isGate        Boolean @default(false)
  isStopWarning Boolean @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([templateId, order])
}

model Task {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taskType  TaskType

  // Common fields
  caseNumber    String
  registrarName String
  ianaId        String
  tldScope      String?
  hasGatewayCnTw Boolean

  // Termination-only fields
  terminationType        String?
  terminationEffectiveDate DateTime?
  gainingRegistrarName   String?
  gainingRegistrarIanaId String?
  icannNoticeDate        DateTime?
  icannNoticeFilePath    String?

  // Name Change / Assignment fields
  oldRegistrarName  String?
  newRegistrarName  String?
  ccid              String?
  taskSubtype       String?   // NAME_CHANGE | ASSIGNMENT, stored as string for flexibility
  aafRequested      Boolean   @default(false)
  aafRequestedDate  DateTime?
  aafReceived       Boolean   @default(false)
  aafReceivedDate   DateTime?
  cnnicTwnicNotified Boolean  @default(false)

  // Optional SFDC IDs
  caseAId String?
  caseBId String?

  // Lifecycle timestamps
  completedAt DateTime?

  // Derived / helper fields
  templateId String?  // template from which task was created
  template   Template? @relation(fields: [templateId], references: [id])

  steps     Step[]
}

model Step {
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  task      Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String

  order         Int
  title         String
  description   String?
  status        StepStatus @default(NOT_STARTED)

  notes          String?
  blockedReason  String?

  isConditional  Boolean @default(false)
  isGate         Boolean @default(false)
  isStopWarning  Boolean @default(false)

  @@index([taskId, order])
}

